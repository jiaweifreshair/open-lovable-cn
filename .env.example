# Required
FIRECRAWL_API_KEY=your_firecrawl_api_key  # Get from https://firecrawl.dev (Web scraping)

# =================================================================================
# SANDBOX PROVIDER - Choose Option 1 OR 2
# =================================================================================

# Option 1: Vercel Sandbox (recommended - default)
# Set SANDBOX_PROVIDER=vercel and choose authentication method below
SANDBOX_PROVIDER=vercel

# Vercel Authentication - Choose method a OR b
# Method a: OIDC Token (recommended for development)
# Run `vercel link` then `vercel env pull` to get VERCEL_OIDC_TOKEN automatically
VERCEL_OIDC_TOKEN=auto_generated_by_vercel_env_pull

# Method b: Personal Access Token (for production or when OIDC unavailable)
# VERCEL_TEAM_ID=team_xxxxxxxxx      # Your Vercel team ID 
# VERCEL_PROJECT_ID=prj_xxxxxxxxx    # Your Vercel project ID
# VERCEL_TOKEN=vercel_xxxxxxxxxxxx   # Personal access token from Vercel dashboard

# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option 2: E2B Sandbox
# Set SANDBOX_PROVIDER=e2b and configure E2B_API_KEY below
# SANDBOX_PROVIDER=e2b
# E2B_API_KEY=your_e2b_api_key  # Get from https://e2b.dev

# =================================================================================
# SANDBOX LIFECYCLE (Optional)
# =================================================================================
# 默认不自动清理沙箱（避免用户未确认就出现预览失效 / Sandbox Not Found）。
# 如需后端兜底清理“超时沙箱”，设置为 1：
# OPEN_LOVABLE_SANDBOX_AUTOCLEANUP=1
#
# 离线/E2E：跳过真实沙箱创建（仅用于测试/CI）
# OPEN_LOVABLE_E2E=1

# =================================================================================
# AI PROVIDERS - Need at least one
# =================================================================================

# Vercel AI Gateway (recommended - provides access to multiple models)
AI_GATEWAY_API_KEY=your_ai_gateway_api_key  # Get from https://vercel.com/dashboard/ai-gateway/api-keys

# =================================================================================
# INTERNATIONAL AI PROVIDERS (Default)
# =================================================================================

# Individual provider keys (used when AI_GATEWAY_API_KEY is not set)
ANTHROPIC_API_KEY=your_anthropic_api_key  # Get from https://console.anthropic.com
OPENAI_API_KEY=your_openai_api_key  # Get from https://platform.openai.com (GPT-5)
GEMINI_API_KEY=your_gemini_api_key  # Get from https://aistudio.google.com/app/apikey
GROQ_API_KEY=your_groq_api_key  # Get from https://console.groq.com (Fast inference - Kimi K2 recommended)

# =================================================================================
# ECA AI Gateway (OpenAI Compatible - Gemini/Claude)
# =================================================================================
# 使用 EdgeCloud Chat Completions 网关
# 支持模型: gemini-3-pro-preview, claude-opus-4-5-20251101
ECA_GATEWAY_ENDPOINT=https://aigateway.edgecloudapp.com/v1/your_project/your_app
ECA_GATEWAY_API_KEY=your_eca_gateway_key
# 兼容网宿文档变量名（可选）
# AIGATEWAY_URL=https://aigateway.edgecloudapp.com/v1/your_project/your_app
# AIGATEWAY_TOKEN=your_eca_gateway_key
# 开发调试：打印 ECA 网关请求/响应摘要与错误详情（默认只在失败时打印）
# ECA_GATEWAY_DEBUG=1
# 兼容旧变量（保留历史环境）
CODE_ASSIST_ENDPOINT=https://aigateway.edgecloudapp.com/v1/your_project/your_app
GOOGLE_CLOUD_ACCESS_TOKEN=your_eca_gateway_key
GEMINI_MODEL=gemini-3-pro-preview  # 默认 Gemini 模型

# =================================================================================
# CHINESE AI PROVIDERS (Optional - for users in China)
# =================================================================================
# These providers offer OpenAI-compatible APIs with Chinese models
# Simply set the base URL and use Chinese models like qwen, deepseek, ernie, etc.
# 中文用户：使用国内模型，无需VPN，访问速度快

# Option 1: Qiniu Cloud AI (七牛云 AI) - Recommended for Chinese users
# Get your API key from: https://www.qiniu.com/ai/chat
# OPENAI_API_KEY=your_qiniu_api_key
# OPENAI_BASE_URL=https://api.qiniu.com/v1
# Available models: qwen-max, qwen-turbo, deepseek-r1, deepseek-chat, etc.

# Option 2: 302.AI - Multiple models with one key
# Get your API key from: https://302.ai
# OPENAI_API_KEY=your_302ai_key
# OPENAI_BASE_URL=https://api.302.ai/v1
# Available models: All major Chinese and international models

# Option 3: 便携AI (BianxieAI) - 100+ models
# Get your API key from: https://bianxieai.com
# OPENAI_API_KEY=your_bianxieai_key
# OPENAI_BASE_URL=https://api.bianxieai.com/v1
# Available models: qwen, ernie, chatglm, kimi, etc.

# Option 4: Aliyun DashScope (阿里云通义千问) - Direct access
# Get your API key from: https://dashscope.aliyun.com
# OPENAI_API_KEY=your_dashscope_key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Available models: qwen-max, qwen-plus, qwen-turbo, etc.

# Note: When using Chinese providers, update the model name in config/app.config.ts
# Example: Change defaultModel to 'qwen-max' or 'deepseek-chat'

# Optional Morph Fast Apply
# Get yours at https://morphllm.com/
MORPH_API_KEY=your_fast_apply_key

# =================================================================================
# AI STREAM TIMEOUT SETTINGS (Optional - adjust for reasoning models)
# =================================================================================
# DeepSeek R1 and other reasoning models may need longer timeouts
# because they "think" before generating output

# Time to wait for first token (default: 25000ms = 25s)
# Increase for reasoning models that need more thinking time
# AI_STREAM_FIRST_TOKEN_TIMEOUT_MS=60000

# Time to wait between tokens before considering stream idle (default: 60000ms = 60s)
# Increase if model pauses during generation
# AI_STREAM_IDLE_TIMEOUT_MS=90000

# Maximum total time for entire generation (default: 240000ms = 4min)
# Increase for large projects with many files (14+ files may need 5-8 min)
# AI_STREAM_TOTAL_TIMEOUT_MS=480000
